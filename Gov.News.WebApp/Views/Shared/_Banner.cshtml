@using Gov.News.Settings
@inject ISiteSettingsSource SiteSettingsSource
@*
    The site banner, as published from Gov.News.Admin (or the built-in defaults when no
    settings storage is configured). Editors change it there, not here.
    Message and link text are HTML-encoded by Razor; links are validated https:// or site paths.
*@
@{
    var settings = await SiteSettingsSource.GetAsync();
    var banner = settings.Banner;
    var isEmergency = banner.Style == "emergency";
    var background = isEmergency ? settings.Theme.Colors.BannerEmergency : settings.Theme.Colors.BannerInfo;
}
@if (banner.IsVisibleAt(DateTimeOffset.UtcNow))
{
    <div id="site-banner" class="info-blue-banner container-fluid sm-g-0" style="background-color:@background;" data-banner-style="@banner.Style" role="@(isEmergency ? "alert" : null)">
        <div class="content container-xl sm-g-0">
            <div style="align-content:center;">
                @if (isEmergency)
                {
                    <i class="fa-solid fa-circle-exclamation fa-lg" aria-hidden="true"></i>
                }
                else
                {
                    <i class="fa fa-info-circle fa-lg" aria-hidden="true"></i>
                }
            </div>
            <div>
                @banner.Message
                @foreach (var link in banner.Links)
                {
                    <a class="BANNER_NEWS" style="font-weight:700; color:#fff;" target="_blank" rel="noopener" href="@link.Url">@link.Text</a>
                }
            </div>
            @if (banner.Dismissible)
            {
                <div style="align-content:center;">
                    <a id="btnCloseBanner" href="#" style="color:#fff;" aria-label="Close banner"><i class="fa fa-xmark fa-lg" aria-hidden="true"></i></a>
                </div>
            }
        </div>
    </div>
}
