@page
@model BannerModel
@{
    ViewData["Title"] = "Site banner";
    var colors = Model.Current.Theme.Colors;
    var modes = new[]
    {
        (Value: "off", Label: "Off", Color: "#8A9099"),
        (Value: "info", Label: "Information", Color: colors.BannerInfo),
        (Value: "emergency", Label: "Emergency", Color: colors.BannerEmergency),
    };
    var previewColor = Model.Input.Mode == "emergency" ? colors.BannerEmergency : colors.BannerInfo;
}

<h1>Site banner</h1>
<p class="text-secondary">Shown across the top of every page. Visitors see changes within two minutes of publishing.</p>

<partial name="_EditorMessages" model="Model" />

<section aria-labelledby="preview-heading" class="card mb-4">
    <div class="card-header small fw-bold text-secondary" id="preview-heading">Preview</div>
    <div id="banner-preview" class="banner-preview" style="background-color: @previewColor" hidden="@(Model.Input.Mode == "off")"
         data-info-color="@colors.BannerInfo" data-emergency-color="@colors.BannerEmergency">
        <span id="banner-preview-text">@Model.Input.Message</span>
        @foreach (var link in Model.Input.Links.Where(l => !string.IsNullOrWhiteSpace(l.Text)))
        {
            <span class="banner-preview-link">@link.Text</span>
        }
    </div>
    <p id="banner-preview-off" class="p-3 mb-0 fst-italic text-secondary" hidden="@(Model.Input.Mode != "off")">No banner is shown.</p>
</section>

<form method="post" id="settings-form" novalidate>
    <input type="hidden" asp-for="BaseETag" />

    <fieldset class="mb-4">
        <legend class="h5">Banner type</legend>
        <div class="d-flex flex-wrap gap-2" id="banner-mode">
            @foreach (var mode in modes)
            {
                <input type="radio" class="btn-check" name="Input.Mode" id="mode-@mode.Value" value="@mode.Value" checked="@(Model.Input.Mode == mode.Value)" />
                <label class="btn btn-outline-primary banner-mode" for="mode-@mode.Value">
                    <span class="banner-mode-dot" style="background-color: @mode.Color" aria-hidden="true"></span>@mode.Label
                </label>
            }
        </div>
        @foreach (var message in Model.ErrorsFor("banner.style"))
        {
            <div class="text-danger mt-1">@message</div>
        }
        <p class="form-text">Information is blue. Emergency is red, for things like wildfire or flood declarations.</p>
    </fieldset>

    <div class="mb-4">
        <label asp-for="Input.Message" class="form-label fw-bold">Message</label>
        <textarea asp-for="Input.Message" class="form-control @(Model.ErrorsFor("banner.message").Any() ? "is-invalid" : "")" rows="3"
                  maxlength="@BannerSettings.MaxMessageLength" aria-describedby="message-help message-count"></textarea>
        @foreach (var message in Model.ErrorsFor("banner.message"))
        {
            <div class="invalid-feedback">@message</div>
        }
        <div class="d-flex justify-content-between form-text">
            <span id="message-help">Plain text. Add links below instead of pasting HTML.</span>
            <span id="message-count">@Model.Input.Message.Length / @BannerSettings.MaxMessageLength</span>
        </div>
    </div>

    <partial name="_LinkList" model="@(new LinkListView("Links in the banner (optional)", "Links", "Input.Links", "banner.links", Model.Input.Links, Model, Reorderable: false))" />

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label asp-for="Input.StartsAt" class="form-label fw-bold">Show from</label>
            <div class="form-text mt-0 mb-1">Pacific time. Blank = as soon as it's published.</div>
            <input asp-for="Input.StartsAt" type="datetime-local" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Input.EndsAt" class="form-label fw-bold">Hide after</label>
            <div class="form-text mt-0 mb-1">Pacific time. Blank = until someone turns it off.</div>
            <input asp-for="Input.EndsAt" type="datetime-local" class="form-control @(Model.ErrorsFor("banner.endsAt").Any() ? "is-invalid" : "")" />
            @foreach (var message in Model.ErrorsFor("banner.endsAt"))
            {
                <div class="invalid-feedback">@message</div>
            }
        </div>
    </div>

    <div class="form-check mb-4">
        <input asp-for="Input.Dismissible" class="form-check-input" />
        <label asp-for="Input.Dismissible" class="form-check-label">Visitors can close the banner</label>
    </div>

    <partial name="_PublishBar" model="Model" />
</form>

@section Scripts {
    <script src="~/js/banner.js" asp-append-version="true"></script>
}
